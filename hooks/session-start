#!/usr/bin/env bash
# SessionStart hook: re-inject the always-on pstack rule (rules/pstack-default.md) at start, clear, and compaction.
# Usage: session-start [cursor|claude|codex|auto]
# Paths resolve relative to this script; no plugin environment variables needed.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
if command -v cygpath >/dev/null 2>&1; then REPO_DIR="$(cygpath -m "$REPO_DIR")"; fi
RULE_FILE="${REPO_DIR}/rules/pstack-default.md"
format="${1:-auto}"

if [ "$format" = auto ]; then
  if [ -n "${CURSOR_VERSION:-}${CURSOR_TRACE_ID:-}${CURSOR_PLUGIN_ROOT:-}" ]; then format=cursor
  elif [ -n "${CLAUDE_PROJECT_DIR:-}${CLAUDE_PLUGIN_ROOT:-}" ]; then format=claude
  elif [ -n "${CODEX_HOME:-}${CODEX_THREAD_ID:-}" ]; then format=codex
  else format=generic
  fi
fi

# Skills auto-update (scripts/check-update.*): silent when up to date or disabled, else one line for the agent.
if [ "${OS:-}" = Windows_NT ]; then
  update_cmd="powershell -NoProfile -ExecutionPolicy Bypass -File ${REPO_DIR}/scripts/check-update.ps1"
  update="$(powershell.exe -NoProfile -ExecutionPolicy Bypass -File "${REPO_DIR}/scripts/check-update.ps1" 2>/dev/null </dev/null || true)"
else
  update_cmd="sh ${REPO_DIR}/scripts/check-update.sh"
  update="$(sh "${REPO_DIR}/scripts/check-update.sh" 2>/dev/null </dev/null || true)"
fi
update="${update%$'\r'}"

if [ -r "$RULE_FILE" ]; then
  body="$(sed -e "s#{{POTETO_MODE}}#${REPO_DIR}/vendor/pstack/skills/poteto-mode/SKILL.md#g" -e "s#{{UPDATE_CHECK}}#${update_cmd}#g" "$RULE_FILE")"
else
  body="For non-trivial engineering work, read vendor/pstack/skills/poteto-mode/SKILL.md in the agent-skills repository and follow it."
fi

escape_for_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

context="Always-on pstack rule (from ${RULE_FILE}, injected by the agent-skills session-start hook; the skills update check already ran):

${body}"
[ -n "$update" ] && context="${update}

${context}"
context="$(escape_for_json "$context")"

# printf instead of a heredoc: bash 5.3+ heredocs can hang in hooks (obra/superpowers#571).
case "$format" in
  cursor)
    printf '{\n  "additional_context": "%s"\n}\n' "$context" ;;
  claude|codex)
    printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$context" ;;
  *)
    printf '{\n  "additionalContext": "%s"\n}\n' "$context" ;;
esac
exit 0
