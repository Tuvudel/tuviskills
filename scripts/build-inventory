#!/usr/bin/env python3
"""Regenerate inventory.json and INVENTORY.md from skills/. Keeps original_locations, broken_shortcuts, excluded."""
import hashlib, json, re
from pathlib import Path
root = Path(__file__).resolve().parents[1]
old = json.loads((root / 'inventory.json').read_text(encoding='utf-8'))
prev = {s['name']: s for s in old.get('skills', [])}
lock = dict(l.split('=', 1) for l in (root / 'vendor' / 'pstack.lock').read_text().split())
vendor_skills = root / 'vendor' / 'pstack' / 'skills'
def fm(text):
    m = re.match(r'---\r?\n(.*?)\r?\n---', text, re.S); d = {}; k = None
    for line in m.group(1).splitlines():
        km = re.match(r'^([A-Za-z0-9_-]+):\s*(.*)$', line)
        if km:
            k = km.group(1); v = km.group(2).strip(); d[k] = '' if v in ('>-', '>', '|') else v.strip('"\'')
        elif k and line.startswith(' '):
            d[k] = (d[k] + ' ' + line.strip()).strip()
    return d
skills = []
for folder in sorted(p for p in (root / 'skills').iterdir() if p.is_dir()):
    meta = fm((folder / 'SKILL.md').read_text(encoding='utf-8'))
    name = meta['name']
    files = {str(f.relative_to(folder)).replace('\\', '/'): hashlib.sha256(f.read_bytes()).hexdigest()
             for f in sorted(folder.rglob('*')) if f.is_file()}
    entry = {'name': name, 'path': 'skills/' + folder.name, 'description': meta.get('description', ''),
             'original_locations': prev.get(name, {}).get('original_locations', []), 'files': files}
    skills.append(entry)
old['skills'] = skills
(root / 'inventory.json').write_text(json.dumps(old, indent=2, ensure_ascii=False) + '\n', encoding='utf-8')
pstack_rows = []
for folder in sorted(p for p in vendor_skills.iterdir() if p.is_dir()):
    meta = fm((folder / 'SKILL.md').read_text(encoding='utf-8'))
    pstack_rows.append('| [%s](vendor/pstack/skills/%s/SKILL.md) | %s |' % (meta['name'], folder.name, meta.get('description', '').replace('|', '\\|')))
rows = '\n'.join('| [%s](%s/SKILL.md) | %s |' % (s['name'], s['path'], s['description'].replace('|', '\\|')) for s in skills)
head = """# Skill inventory

%d personal skills from `skills/` plus %d pstack skills vendored unmodified in `vendor/pstack/`, generated by `scripts/build-inventory`. Do not edit by hand. Archived skills are in `archive/` and are not installed.

Engineering work starts from [poteto-mode](vendor/pstack/skills/poteto-mode/SKILL.md), which the always-on rule in `rules/pstack-default.*` loads. Other entry skills: [design-ui](skills/design-ui/SKILL.md), [illustrate](skills/illustrate/SKILL.md), [docs-writing](skills/docs-writing/SKILL.md). Upstream sources and licenses are listed in [UPSTREAM.md](UPSTREAM.md).

## Personal skills

| Skill | Purpose |
| --- | --- |
""" % (len(skills), len(pstack_rows))
tail = """
## pstack %s (vendored, unmodified)

| Skill | Purpose |
| --- | --- |
""" % lock['version']
(root / 'INVENTORY.md').write_text(head + rows + '\n' + tail + '\n'.join(pstack_rows) + '\n', encoding='utf-8')
print('%d skills written' % len(skills))
